{
  "expo": {
    "name": "SENAI",
    "slug": "senai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/senai-logo.svg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/senai-logo.svg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/senai-logo.svg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/senai-logo.svg"
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
